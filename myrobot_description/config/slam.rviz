Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Map
      Name: Map
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Enabled: true

    - Class: rviz_common/Map
      Name: GlobalCostmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Alpha: 0.5
      Color Scheme: costmap
      Enabled: true

    - Class: rviz_common/Map
      Name: LocalCostmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Alpha: 0.5
      Color Scheme: costmap
      Enabled: true

    - Class: rviz_common/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.05
      Enabled: true

    - Class: rviz_common/Path
      Name: Plan
      Topic:
        Value: /plan
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color:
        R: 0
        G: 255
        B: 0
      Enabled: true

    - Class: rviz_common/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: false

  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color:
      R: 48
      G: 48
      B: 48

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/SetInitialPose

Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
