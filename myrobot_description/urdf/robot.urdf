<?xml version="1.0"?>
<robot name="amr_robot">

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1 1 0.5"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1 1 0.5"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="30.0"/>
      <inertia
        ixx="1.50" ixy="0.0" ixz="0.0"
        iyy="1.50" iyz="0.0"
        izz="1.50"/>
    </inertial>
  </link>

  <!-- ================= LEFT FRONT WHEEL ================= -->
  <link name="left_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.02" ixy="0.0" ixz="0.0"
        iyy="0.02" iyz="0.0"
        izz="0.02"/>
    </inertial>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.32 0.55 -0.25"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= LEFT MIDDLE WHEEL ================= -->
  <link name="left_middle_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.02" ixy="0.0" ixz="0.0"
        iyy="0.02" iyz="0.0"
        izz="0.02"/>
    </inertial>
  </link>

  <joint name="left_middle_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_middle_wheel"/>
    <origin xyz="0.00 0.55 -0.25"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= LEFT REAR WHEEL ================= -->
  <link name="left_rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.02" ixy="0.0" ixz="0.0"
        iyy="0.02" iyz="0.0"
        izz="0.02"/>
    </inertial>
  </link>

  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="-0.32 0.55 -0.25"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= RIGHT FRONT WHEEL ================= -->
  <link name="right_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.02" ixy="0.0" ixz="0.0"
        iyy="0.02" iyz="0.0"
        izz="0.02"/>
    </inertial>
  </link>

  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.32 -0.55 -0.25"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= RIGHT MIDDLE WHEEL ================= -->
  <link name="right_middle_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.02" ixy="0.0" ixz="0.0"
        iyy="0.02" iyz="0.0"
        izz="0.02"/>
    </inertial>
  </link>

  <joint name="right_middle_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_middle_wheel"/>
    <origin xyz="0.00 -0.55 -0.25"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= RIGHT REAR WHEEL ================= -->
  <link name="right_rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <origin rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.02" ixy="0.0" ixz="0.0"
        iyy="0.02" iyz="0.0"
        izz="0.02"/>
    </inertial>
  </link>

  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="-0.32 -0.55 -0.25"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= LIDAR ================= -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.08"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.3"/>
      <inertia
        ixx="0.005" ixy="0.0" ixz="0.0"
        iyy="0.005" iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.25 0 0.32"/>
  </joint>

  <!-- ================= GAZEBO WHEEL FRICTION ================= -->
  <gazebo reference="left_front_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="left_middle_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="left_rear_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="right_front_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="right_middle_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="right_rear_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- ================= GAZEBO DIFF DRIVE ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_middle_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_middle_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>1.10</wheel_separation>
      <wheel_radius>0.18</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- ================= LIDAR SENSOR ================= -->
  <gazebo reference="laser_frame">
    <sensor name="front_lidar_sensor" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>0.01</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.08</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
